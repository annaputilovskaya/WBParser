# Конфигурация WBParser
# Скопируйте этот файл в .env и заполните значения

# Базовые URL Wildberries
WB_BASE_URL=https://www.wildberries.ru
WB_API_SEARCH_URL=https://www.wildberries.ru/__internal/u-search/exactmatch/ru/common/v18/search

# Заголовки (можно оставить по умолчанию)
# WB_API_HEADERS={"accept": "*/*", "accept-language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7", ...}

# Параметры запросов
WB_REQUEST_TIMEOUT=10
WB_DELAY_BETWEEN_REQUESTS=0.3
WB_PAGE_DELAY=0.1
WB_MAX_THREADS=30

# Параметры API
WB_MAX_RETRIES=3
WB_RETRY_DELAYS=1,2,3
WB_TOKEN_COOKIE_NAME=x_wbaas_token

# Папки вывода
WB_OUTPUT_DIR=output
WB_FULL_CATALOG_FILENAME=full_catalog.xlsx
WB_FILTERED_CATALOG_FILENAME=filtered_catalog.xlsx
WB_BASIC_CATALOG_FILENAME=basic_catalog.xlsx

# Логирование
WB_LOG_LEVEL=INFO
WB_LOG_FORMAT=[%(asctime)s.%(msecs)03d] %(levelname)-8s %(funcName)20s %(module)s:%(lineno)d - %(message)s
WB_LOGS_DIR=logs
WB_LOG_FORMAT_JSON=false
WB_LOG_MAX_BYTES=10485760
WB_LOG_BACKUP_COUNT=5
WB_LOG_SEPARATE_ERROR_FILE=true

# Критерии фильтрации
WB_MIN_RATING=4.5
WB_MAX_PRICE=10000.0
WB_TARGET_COUNTRY=Россия

# Поисковый запрос по умолчанию
WB_DEFAULT_SEARCH_QUERY=пальто из натуральной шерсти

# Параметры поискового API (JSON)
WB_SEARCH_API_PARAMS={"ab_testing": ["false", "false"], "appType": "1", "curr": "rub", "dest": "-412733", "hide_vflags": "4294967296", "inheritFilters": "false", "lang": "ru", "resultset": "catalog", "sort": "popular", "spp": "30", "suppressSpellcheck": "false"}

# Параметры парсинга
WB_LIMIT_PER_REQUEST=1200
WB_DEFAULT_BASE_RANGES=0-5000;5001-10000;10001-15000;15001-25000;25001-10000000

# Ротация User-Agent
WB_USER_AGENT_ROTATION=true

# Прокси (разделенные запятыми)
WB_PROXY_POOL=

# Экспоненциальный backoff
WB_EXPONENTIAL_BACKOFF_BASE=2.0
WB_EXPONENTIAL_BACKOFF_MAX_DELAY=60.0